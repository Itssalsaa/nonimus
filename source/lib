end
function Chloex:SetLanguage(code)
	code = string.lower(tostring(code or "en")):match("^(%a+)") or "en"
	if not LIBSTR[code] then
		code = "en"
	end
	if code == libLang then
		return libLang
	end
	libLang = code
	for _, fn in ipairs(libLangListeners) do
		pcall(fn)
	end
	return libLang
end
